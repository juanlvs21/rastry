{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rastry.dev/schemas/pipeline-v1.json",
  "title": "Rastry pipeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "operations"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": { "const": "resize" },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "fit": { "enum": ["contain", "cover", "fill"] }
            },
            "anyOf": [{ "required": ["width"] }, { "required": ["height"] }]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "format"],
            "properties": {
              "type": { "const": "convert" },
              "format": { "enum": ["png", "jpeg", "webp"] },
              "quality": { "type": "integer", "minimum": 1, "maximum": 100 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": { "type": { "const": "strip-metadata" } }
          }
        ]
      }
    }
  }
}

