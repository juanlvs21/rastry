{
  "name": "rastry",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "license": "Apache-2.0",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "^1.4.0",
      "typescript": "^7.0.0"
    }
  },
  "scripts": {
    "prepare": "lefthook install",
    "lint:commit": "commitlint",
    "dev:cli": "bun --filter @rastry/cli dev",
    "dev:desktop": "bun --filter @rastry/desktop dev",
    "dev:desktop:hmr": "bun --filter @rastry/desktop dev:hmr",
    "build:cli": "bun --filter @rastry/cli build",
    "build:desktop": "bun --filter @rastry/desktop build",
    "typecheck": "bun --filter './packages/*' typecheck && bun --filter @rastry/cli typecheck && bun --filter @rastry/desktop typecheck",
    "test": "bun test",
    "check": "bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "lefthook": "2.1.10"
  }
}
