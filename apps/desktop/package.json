{
  "name": "@rastry/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && electrobun dev --watch",
    "dev:hmr": "electrobun prepare && concurrently --kill-others-on-fail \"vite --port 5173\" \"electrobun dev\"",
    "build": "vite build && electrobun build --env=stable",
    "build:view": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rastry/contracts": "workspace:*",
    "@rastry/core": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electrobun": "2.0.1",
    "typescript": "catalog:",
    "vite": "^7.1.3"
  }
}
