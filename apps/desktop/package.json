{
  "name": "@rastry/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && electrobun dev --watch",
    "dev:hmr": "electrobun prepare && concurrently --kill-others-on-fail \"vite --port 5173\" \"electrobun dev\"",
    "build": "vite build && electrobun build --env=stable",
    "build:view": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rastry/contracts": "workspace:*",
    "@rastry/core": "workspace:*",
    "@rastry/image-engine": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "electrobun": "2.0.1",
    "typescript": "catalog:",
    "vite": "8.2.2"
  }
}
