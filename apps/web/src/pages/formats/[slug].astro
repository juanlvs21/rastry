---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { ArrowRight, ArrowUpRight } from "@lucide/astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { assertUniqueSlugs, canonicalUrl, repositoryUrl } from "../../lib/content";

export async function getStaticPaths() {
  const entries = await getCollection("formats");
  assertUniqueSlugs(entries, "formats");
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"formats">;
}

const { entry } = Astro.props as Props;
const { Content } = await render(entry);
---
<SiteLayout
  title={entry.data.title + " · Rastry"}
  description={entry.data.description}
  canonical={canonicalUrl("/formats/" + entry.data.slug + "/")}
  breadcrumbs={[
    { name: "Rastry", path: "/" },
    { name: "Formats", path: "/formats/" },
    { name: entry.data.title, path: "/formats/" + entry.data.slug + "/" },
  ]}
>
  <div class="article-shell">
    <header>
      <p class="kicker">Format · {entry.data.format.toUpperCase()}</p>
      <h1>{entry.data.title}</h1>
      <p class="article-shell__summary">{entry.data.description}</p>
      <div class="meta-row">
        <span class="tag tag--green">Input + output</span>
        <a class="tag tag--warm" href={repositoryUrl + "/blob/main/" + entry.data.sourcePath} target="_blank" rel="noopener noreferrer">View source <ArrowUpRight size={14} /></a>
        <a class="tag" href={entry.data.docsPath}>Read the docs <ArrowRight size={14} /></a>
      </div>
    </header>
    <article class="article">
      <Content />
      <h2>Related reading</h2>
      <ul>
        {entry.data.related.map((link) => <li><a href={link}>{link}</a></li>)}
      </ul>
    </article>
  </div>
</SiteLayout>
