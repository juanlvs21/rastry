---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Page not found · Rastry" description="The Rastry page you requested could not be found." noindex>
  <div class="article-shell">
    <header>
      <p class="kicker">404</p>
      <h1>This path did not make the plan.</h1>
      <p class="article-shell__summary">The page may have moved, or the URL may be incomplete.</p>
    </header>
    <article class="article">
      <p><a href="/">Return to Rastry home →</a></p>
      <p><a href="/docs/">Open the documentation →</a></p>
    </article>
  </div>
</SiteLayout>
