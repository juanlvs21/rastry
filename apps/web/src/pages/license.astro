---
import SiteLayout from "../layouts/SiteLayout.astro";
import { repositoryUrl } from "../lib/content";
---
<SiteLayout title="License · Rastry" description="Rastry is released under the Apache License 2.0." breadcrumbs={[{ name: "Rastry", path: "/" }, { name: "License", path: "/license/" }]}>
  <div class="article-shell">
    <header><p class="kicker">Project</p><h1>Apache License 2.0.</h1><p class="article-shell__summary">Rastry is open source and intended to be useful in personal, commercial, and team workflows.</p></header>
    <article class="article">
      <h2>What this means</h2>
      <p>The Apache License 2.0 permits use, modification, distribution, and commercial work, subject to the license terms and notices. It also includes an express patent grant.</p>
      <p>Read the complete license in the repository: <a href={repositoryUrl + "/blob/main/LICENSE"} target="_blank" rel="noopener noreferrer">LICENSE ↗</a>. The project notice is available in <a href={repositoryUrl + "/blob/main/NOTICE"} target="_blank" rel="noopener noreferrer">NOTICE ↗</a>.</p>
      <h2>Third-party dependencies</h2>
      <p>Dependencies retain their own licenses. Release artifacts and future distributions should preserve the required notices.</p>
    </article>
  </div>
</SiteLayout>
